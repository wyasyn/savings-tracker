# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
# Create a project at https://neon.tech and copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# better-auth. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The app's base URL (no trailing slash). Use http://localhost:3000 in dev.
BETTER_AUTH_URL="http://localhost:3000"
# Same URL, exposed to the browser for the auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (Leave blank to hide the Google button until you configure it.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — https://resend.com/api-keys  (sends the 6-digit sign-in code)
# Leave blank in dev to print the code to the server console instead of emailing.
RESEND_API_KEY=""
# Verified sender. Use "Acme <onboarding@resend.dev>" for quick testing.
EMAIL_FROM="Savings Tracker <onboarding@resend.dev>"

# Admin dashboard — comma-separated emails that are always treated as admins.
# These accounts are auto-promoted to the `admin` role on first visit to /admin,
# which bootstraps the very first admin (who can then promote others in the UI).
ADMIN_EMAILS=""

# Mobile app (Expo) — comma-separated deep-link scheme(s) better-auth should
# trust as origins, in addition to BETTER_AUTH_URL (already trusted). Use the
# app's production scheme plus the Expo Go dev URLs while developing, e.g.
#   MOBILE_TRUSTED_ORIGINS="savingstracker://,exp://"
# Leave blank until the mobile app exists.
MOBILE_TRUSTED_ORIGINS=""

# App-store reviewer access. Set REVIEWER_EMAIL to enable a single locked-down
# account that always accepts REVIEWER_OTP (default 000000) instead of an emailed
# code — so Google/Apple reviewers can sign in to a passwordless app. Seed it
# with sample data via `REVIEWER_EMAIL=... pnpm seed:test-user`. Leave blank in
# normal operation; unset again once the review passes.
REVIEWER_EMAIL=""
REVIEWER_OTP="000000"
