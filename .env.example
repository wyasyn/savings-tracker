# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
# Create a project at https://neon.tech and copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# better-auth. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The app's base URL (no trailing slash). Use http://localhost:3000 in dev.
BETTER_AUTH_URL="http://localhost:3000"
# Same URL, exposed to the browser for the auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (Leave blank to hide the Google button until you configure it.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — https://resend.com/api-keys  (sends the 6-digit sign-in code)
# Leave blank in dev to print the code to the server console instead of emailing.
RESEND_API_KEY=""
# Verified sender. Use "Acme <onboarding@resend.dev>" for quick testing.
EMAIL_FROM="Savings Tracker <onboarding@resend.dev>"
